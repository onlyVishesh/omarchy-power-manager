#!/bin/bash
set -euo pipefail

CONFIG_FILE="${OMARCHY_POWER_CONF:-${1:-}}"
if [ -z "$CONFIG_FILE" ]; then
    CANDIDATES=()
    if [ -n "${SUDO_USER:-}" ]; then
        U_HOME=$(getent passwd "$SUDO_USER" 2>/dev/null | cut -d: -f6 || true)
        if [ -n "$U_HOME" ]; then CANDIDATES+=("$U_HOME/.config/onlyvishesh.power-manager.json"); fi
    fi
    if [ -n "${XDG_CONFIG_HOME:-}" ]; then CANDIDATES+=("$XDG_CONFIG_HOME/onlyvishesh.power-manager.json"); fi
    if [ -n "${HOME:-}" ]; then CANDIDATES+=("$HOME/.config/onlyvishesh.power-manager.json"); fi
    for u_home in /home/*; do
        if [ -d "$u_home/.config" ]; then CANDIDATES+=("$u_home/.config/onlyvishesh.power-manager.json"); fi
    done
    for cand in "${CANDIDATES[@]}"; do
        if [ -f "$cand" ]; then CONFIG_FILE="$cand"; break; fi
    done
fi

if [ -z "$CONFIG_FILE" ] || [ ! -f "$CONFIG_FILE" ]; then
    echo '{"success": false, "errors": ["Config file missing or invalid"]}'
    exit 1
fi

if ! jq empty "$CONFIG_FILE" 2>/dev/null; then
    echo '{"success": false, "errors": ["Malformed JSON configuration"]}'
    exit 1
fi

DIR="$(dirname "$(realpath "$0")")"
if [ ! -x "$DIR/power-manager-profile-switch" ]; then
    echo '{"success": false, "errors": ["Profile helper missing"]}'
    exit 1
fi

UDEV_DIR="${OMARCHY_UDEV_DIR:-/etc/udev/rules.d}"
if [ "$(id -u)" -eq 0 ] || [ -n "${OMARCHY_UDEV_DIR:-}" ]; then
    mkdir -p "$UDEV_DIR" 2>/dev/null || true
    if ! cat <<UDEV > "$UDEV_DIR/90-omarchy-power-manager.rules" 2>/dev/null
SUBSYSTEM=="power_supply", ACTION=="change", RUN+="$DIR/power-manager-profile-switch $CONFIG_FILE"
UDEV
    then
        echo '{"success": false, "errors": ["Failed to write udev rules"]}'
        exit 1
    fi

    if command -v udevadm >/dev/null 2>&1 && [ "$(id -u)" -eq 0 ]; then
        udevadm control --reload-rules 2>/dev/null || true
    fi
fi

# Delegate the rest to profile switch (which now handles logind and sleep configs dynamically)
if [ -x "$DIR/power-manager-profile-switch" ]; then
    "$DIR/power-manager-profile-switch" "$CONFIG_FILE" >/dev/null
fi

echo '{"success": true, "applied": ["udev", "profile", "logind"], "errors": []}'
exit 0
